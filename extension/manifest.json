{
  "manifest_version": 3,
  "name": "ProxyBridge",
  "version": "1.1.1",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7654/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-off-16.png",
      "48": "icon-off-48.png",
      "128": "icon-off-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-off-16.png",
    "48": "icon-off-48.png",
    "128": "icon-off-128.png"
  }
}